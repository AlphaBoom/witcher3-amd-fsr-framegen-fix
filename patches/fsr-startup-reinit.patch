+	// Reapply the existing user-selected FSR FG mode after loading has finished.
+	// The two setting changes must occur in separate rendered frames.
+	timer function FSRStartupReinitialize( dt : float, id : int )
+	{
+		var config : CInGameConfigWrapper;
+		if ( this != thePlayer || !theGame.GetFSRFramegenSupported() || !theGame.GetFSRFramegenEnabled() )
+		{
+			return;
+		}
+		config = (CInGameConfigWrapper)theGame.GetInGameConfigWrapper();
+		config.SetVarValue( 'Graphics', 'Virtual_FSRFramegen', "0" );
+		AddTimer( 'FSRStartupRestoreEnabled', 0.5f, false );
+	}
+
+	timer function FSRStartupRestoreEnabled( dt : float, id : int )
+	{
+		var config : CInGameConfigWrapper;
+		config = (CInGameConfigWrapper)theGame.GetInGameConfigWrapper();
+		config.SetVarValue( 'Graphics', 'Virtual_FSRFramegen', "1" );
+	}
